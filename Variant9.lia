(patternDef "V9_KC407_6P_R10" (originalName "V9_KC407_6P_R10")
 (multiLayer
(pad (padNum 1) (padStyleRef "V9_D10_S18") (pt -5 -2.5))
(pad (padNum 2) (padStyleRef "V9_D10_R18") (pt -5 0))
(pad (padNum 3) (padStyleRef "V9_D10_R18") (pt -5 2.5))
(pad (padNum 4) (padStyleRef "V9_D10_R18") (pt 5 2.5))
(pad (padNum 5) (padStyleRef "V9_D10_R18") (pt 5 0))
(pad (padNum 6) (padStyleRef "V9_D10_R18") (pt 5 -2.5)))
 (layerContents (layerNumRef 6)
(line (pt -3 -3.75) (pt 3 -3.75) (width 0.25))
(line (pt 3 -3.75) (pt 3 3.75) (width 0.25))
(line (pt 3 3.75) (pt -3 3.75) (width 0.25))
(line (pt -3 3.75) (pt -3 -3.75) (width 0.25))
(line (pt -3 -3) (pt -2 -3) (width 0.25))
(line (pt -2 -3) (pt -2 -3.75) (width 0.25))
(attr "RefDes" "" (pt 0 5.5) (isVisible True) (justify Center) (textStyleRef "V9_PCB"))
(attr "Type" "" (pt 0 -5.5) (isVisible False) (justify Center) (textStyleRef "V9_PCB"))
(attr "Value" "" (pt 0 -7) (isVisible False) (justify Center) (textStyleRef "V9_PCB")))
 (layerContents (layerNumRef 10)
(line (pt -3 -3.75) (pt 3 -3.75) (width 0.25))
(line (pt 3 -3.75) (pt 3 3.75) (width 0.25))
(line (pt 3 3.75) (pt -3 3.75) (width 0.25))
(line (pt -3 3.75) (pt -3 -3.75) (width 0.25)))
)

(patternDef "V9_KM6A_H90_P3_5" (originalName "V9_KM6A_H90_P3_5")
 (multiLayer
(pad (padNum 1) (padStyleRef "V9_D09_R20") (pt -1.75 0))
(pad (padNum 2) (padStyleRef "V9_D09_R20") (pt 1.75 0)))
