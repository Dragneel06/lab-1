)

(compDef "KC407" (originalName "KC407")
(compHeader (compType Normal) (numPins 6) (numParts 1) (composition Homogeneous) (refDesPrefix "VD") (numType Numeric))
(compPin "1" (pinName "MINUS") (partNum 1) (symPinNum 1) (gateEq 0) (pinEq -1) (pinType Passive))
(compPin "2" (pinName "AC1") (partNum 1) (symPinNum 2) (gateEq 0) (pinEq 0) (pinType Passive))
