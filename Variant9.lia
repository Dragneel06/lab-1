(padStyleDef "V9_D10_R18" (holeDiam 1) (isHolePlated True) (startRange 1) (endRange 2)
 (padShape (layerType Signal) (padShapeType Ellipse) (shapeWidth 1.80) (shapeHeight 1.80))
 (padShape (layerType NonSignal) (padShapeType Ellipse) (shapeWidth 0.00) (shapeHeight 0.00))
