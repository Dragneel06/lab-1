(line (pt -3.25 3.25) (pt -3.25 -3.25) (width 0.25)))
)

(symbolDef "V9_KC407_SYM" (originalName "V9_KC407_SYM")
(pin (pinNum 1) (pt -4 0) (rotation 180) (pinLength 3.5) (pinDisplay (dispPinDes False) (dispPinName False)))
(pin (pinNum 2) (pt 0 4) (rotation 90) (pinLength 3.5) (pinDisplay (dispPinDes False) (dispPinName False)))
(pin (pinNum 3) (pt 4 0) (rotation 0) (pinLength 3.5) (pinDisplay (dispPinDes False) (dispPinName False)))
(pin (pinNum 4) (pt 4 0) (rotation 0) (pinLength 3.5) (pinDisplay (dispPinDes False) (dispPinName False)))
(pin (pinNum 5) (pt 0 -4) (rotation 270) (pinLength 3.5) (pinDisplay (dispPinDes False) (dispPinName False)))
(pin (pinNum 6) (pt -4 0) (rotation 180) (pinLength 3.5) (pinDisplay (dispPinDes False) (dispPinName False)))
(line (pt -4 0) (pt 0 4) (width 0.25))
(line (pt 0 4) (pt 4 0) (width 0.25))
(line (pt 4 0) (pt 0 -4) (width 0.25))
(line (pt 0 -4) (pt -4 0) (width 0.25))
(line (pt -1.25 -1.25) (pt -1.25 1.25) (width 0.25))
(line (pt -1.25 1.25) (pt 1.25 0) (width 0.25))
(line (pt 1.25 0) (pt -1.25 -1.25) (width 0.25))
(line (pt -2 0) (pt 2 0) (width 0.25))
(line (pt 1.25 -1.25) (pt 1.25 1.25) (width 0.25))
(text (pt -5.7 1.15) "1,6 -" (textStyleRef "V9_SMALL") (justify Center))
(text (pt 5.7 1.15) "3,4 +" (textStyleRef "V9_SMALL") (justify Center))
(text (pt 1.6 5.7) "2 ~" (textStyleRef "V9_SMALL") (justify Center))
(text (pt 1.6 -5.7) "5 ~" (textStyleRef "V9_SMALL") (justify Center))
(attr "RefDes" "" (pt 0 9) (isVisible True) (justify Center) (textStyleRef "V9_SCH"))
(attr "Type" "" (pt 0 -9) (isVisible True) (justify Center) (textStyleRef "V9_SCH"))
(attr "Value" "" (pt 0 -11.5) (isVisible False) (justify Center) (textStyleRef "V9_SCH"))
)

(symbolDef "V9_KM6A_H90_SYM" (originalName "V9_KM6A_H90_SYM")
