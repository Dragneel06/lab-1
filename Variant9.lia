(attr "Value" "" (pt 0 0) (isVisible False) (justify Center) (textStyleRef "V9_SCH"))
(attr "BodyLength_mm" "6" (pt 0 0) (isVisible False) (justify Center) (textStyleRef "V9_SCH"))
(attr "BodyWidth_mm" "7.5" (pt 0 0) (isVisible False) (justify Center) (textStyleRef "V9_SCH"))
