(attachedSymbol (partNum 1) (altType Normal) (symbolName "V9_KC407_SYM"))
(attachedPattern (patternNum 1) (patternName "V9_KC407_6P_R10") (numPads 6) (padPinMap (padNum 1) (compPinRef "1") (padNum 2) (compPinRef "2") (padNum 3) (compPinRef "3") (padNum 4) (compPinRef "4") (padNum 5) (compPinRef "5") (padNum 6) (compPinRef "6")))
